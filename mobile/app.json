{
  "expo": {
    "name": "AniKeeper",
    "slug": "anikeeper",
    "scheme": "anikeeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.anikeeper.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AniKeeper precisa acessar suas fotos para definir sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
